<view class="container">
  <view class="form-card">
    <view class="form-item">
      <text class="label">收货人</text>
      <input class="input" placeholder="请输入收货人姓名" value="{{form.name}}" bindinput="onInput" data-field="name" maxlength="20" />
    </view>
    <view class="form-item">
      <text class="label">手机号码</text>
      <input class="input" type="number" placeholder="请输入手机号码" value="{{form.phone}}" bindinput="onInput" data-field="phone" maxlength="11" />
    </view>
    <view class="form-item" bindtap="onChooseRegion">
      <text class="label">所在地区</text>
      <view class="region-value {{form.regionText ? '' : 'placeholder'}}">{{form.regionText || '请选择省 / 市 / 区'}}</view>
      <image class="arrow" src="/images/arrow-right.png" mode="aspectFit" />
    </view>
    <view class="form-item form-item--textarea">
      <text class="label">详细地址</text>
      <textarea class="textarea" placeholder="街道、门牌号、楼层等详细信息" value="{{form.detail}}" bindinput="onInput" data-field="detail" maxlength="100" auto-height />
    </view>
    <view class="form-item">
      <text class="label">设为默认</text>
      <switch checked="{{form.isDefault}}" bindchange="onSwitchChange" color="#ff6700" />
    </view>
  </view>
  <view class="bottom-bar">
    <button class="btn-save" bindtap="onSave">保存</button>
  </view>
</view>